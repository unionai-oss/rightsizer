{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttemptRecord",
  "description": "An attempt record and ladder lease, written before every attempt\nrightsizer changes (SPEC §7.2):\n`{prefix}/v1/attempts/{tenant}/{key-hash}/{invocation-hash}.json`.",
  "type": "object",
  "properties": {
    "applied": {
      "description": "Attempt 1's applied requests.",
      "$ref": "#/$defs/Requests"
    },
    "decision_id": {
      "description": "Attempt 1's decision.",
      "type": [
        "string",
        "null"
      ]
    },
    "invocation_id": {
      "description": "Invocation id.",
      "type": "string"
    },
    "key": {
      "description": "Workload key.",
      "$ref": "#/$defs/WorkloadKey"
    },
    "lease": {
      "description": "The ladder lease, for Caller ladders.",
      "anyOf": [
        {
          "$ref": "#/$defs/Lease"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin_prior": {
      "description": "The origin prior's requests.",
      "$ref": "#/$defs/Requests"
    },
    "reduced": {
      "description": "Whether attempt 1 was below the origin prior on an incompressible axis.",
      "type": "boolean"
    },
    "v": {
      "description": "Wire version (1).",
      "type": "integer",
      "format": "uint16",
      "default": 1,
      "maximum": 65535,
      "minimum": 0
    },
    "written_at": {
      "description": "When written.",
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "invocation_id",
    "origin_prior",
    "applied",
    "reduced",
    "written_at"
  ],
  "$defs": {
    "AcceleratorId": {
      "description": "A canonical accelerator id with per-device memory and family (SPEC §5.1.1).\nJSON: the canonical string, e.g. `\"A100-80G\"`; parsing is case-insensitive.",
      "oneOf": [
        {
          "description": "NVIDIA T4, 16 GB.",
          "type": "string",
          "const": "T4-16G"
        },
        {
          "description": "NVIDIA L4, 24 GB.",
          "type": "string",
          "const": "L4-24G"
        },
        {
          "description": "NVIDIA A10G (AWS), 24 GB.",
          "type": "string",
          "const": "A10G-24G"
        },
        {
          "description": "NVIDIA A10, 24 GB.",
          "type": "string",
          "const": "A10-24G"
        },
        {
          "description": "NVIDIA L40S, 48 GB.",
          "type": "string",
          "const": "L40S-48G"
        },
        {
          "description": "NVIDIA A100, 40 GB.",
          "type": "string",
          "const": "A100-40G"
        },
        {
          "description": "NVIDIA A100, 80 GB.",
          "type": "string",
          "const": "A100-80G"
        },
        {
          "description": "NVIDIA H100, 80 GB.",
          "type": "string",
          "const": "H100-80G"
        },
        {
          "description": "NVIDIA H200, 141 GB.",
          "type": "string",
          "const": "H200-141G"
        },
        {
          "description": "NVIDIA B200, 180 GB.",
          "type": "string",
          "const": "B200-180G"
        },
        {
          "description": "AMD MI300X, 192 GB.",
          "type": "string",
          "const": "MI300X-192G"
        },
        {
          "description": "Google TPU v5e (per chip).",
          "type": "string",
          "const": "TPU-V5E"
        },
        {
          "description": "Google TPU v5p (per chip).",
          "type": "string",
          "const": "TPU-V5P"
        },
        {
          "description": "Google TPU v6e / Trillium (per chip).",
          "type": "string",
          "const": "TPU-V6E"
        },
        {
          "description": "AWS Trainium 1 (per chip).",
          "type": "string",
          "const": "TRN1"
        },
        {
          "description": "AWS Trainium 2 (per chip).",
          "type": "string",
          "const": "TRN2"
        },
        {
          "description": "AWS Inferentia 2 (per chip).",
          "type": "string",
          "const": "INF2"
        },
        {
          "description": "A GPU of unknown type. Its type is never changed (SPEC §5.1.1).",
          "type": "string",
          "const": "unknown-gpu"
        }
      ]
    },
    "Bytes": {
      "description": "A byte count. JSON: an unsigned integer.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "GpuShape": {
      "description": "An accelerator type × count (SPEC §5.1, §5.4).",
      "type": "object",
      "properties": {
        "accel": {
          "description": "Canonical accelerator id.",
          "$ref": "#/$defs/AcceleratorId"
        },
        "count": {
          "description": "Number of devices.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "accel",
        "count"
      ]
    },
    "Lease": {
      "description": "A ladder lease (SPEC §7.2): open before each reduced attempt; closed by\nthe component that classifies the failure.",
      "type": "object",
      "properties": {
        "closed_at": {
          "description": "Closed at, if closed.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "opened_at": {
          "description": "Opened at.",
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "description": "Final status, if known.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "opened_at"
      ]
    },
    "MilliCpu": {
      "description": "CPU in millicores (1000 = one core). JSON: an unsigned integer.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "Requests": {
      "description": "Resource requests of one unit (SPEC §5.1). `None` = not set.",
      "type": "object",
      "properties": {
        "cpu": {
          "description": "CPU.",
          "anyOf": [
            {
              "$ref": "#/$defs/MilliCpu"
            },
            {
              "type": "null"
            }
          ]
        },
        "ephemeral_storage": {
          "description": "Ephemeral storage.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu": {
          "description": "Accelerators.",
          "anyOf": [
            {
              "$ref": "#/$defs/GpuShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "description": "Memory.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "shm": {
          "description": "Shared memory.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bytes"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RunStatus": {
      "description": "Run status (SPEC §5.7).",
      "oneOf": [
        {
          "description": "Succeeded.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Killed for memory (host).",
          "type": "string",
          "const": "oom_killed"
        },
        {
          "description": "CUDA / device out of memory.",
          "type": "string",
          "const": "gpu_oom"
        },
        {
          "description": "Evicted (e.g. node memory pressure).",
          "type": "string",
          "const": "evicted"
        },
        {
          "description": "Hit its walltime.",
          "type": "string",
          "const": "timeout"
        },
        {
          "description": "Preempted by the platform.",
          "type": "string",
          "const": "preempted"
        },
        {
          "description": "Failed for another (application) reason.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Served from cache: no measurements, excluded from learning.",
          "type": "string",
          "const": "cached"
        },
        {
          "description": "Unknown.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "WorkloadKey": {
      "description": "Workload key `{platform}://{tenant}/{suffix}` (or `{platform}://{tenant}//{suffix}`).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}://.+/.+$"
    }
  }
}
