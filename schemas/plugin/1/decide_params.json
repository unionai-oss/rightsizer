{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecideParams",
  "description": "`decide` params (shim → daemon).",
  "type": "object",
  "properties": {
    "attempt": {
      "description": "Extension: the attempt being sized (escalate-on-retry, SPEC §7.2).",
      "anyOf": [
        {
          "$ref": "#/$defs/AttemptContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadline_ms": {
      "description": "Deadline.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "dry_run": {
      "description": "Extension: decide but do not record.",
      "type": "boolean"
    },
    "env": {
      "description": "Hosting environment. Over the daemon socket, `principal` and\n`namespace` are ignored: the daemon derives them from `SO_PEERCRED`.",
      "$ref": "#/$defs/AdapterEnv",
      "default": {
        "settings": {}
      }
    },
    "kind": {
      "description": "Adapter kind (built-in or plugin).",
      "type": "string"
    },
    "mode": {
      "description": "Requested mode (capped by policy, breakers and `mode_ceiling`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Mode"
        },
        {
          "type": "null"
        }
      ]
    },
    "native": {
      "description": "The submission.",
      "$ref": "#/$defs/Native"
    },
    "watch": {
      "description": "Extension: a `Caller` ladder drives this submission (`rsz slurm\nsbatch --watch`), so reductions may rest on S3(a).",
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "native"
  ],
  "$defs": {
    "AdapterEnv": {
      "description": "What the hosting surface tells an adapter (cluster, caller identity, deadline).",
      "type": "object",
      "properties": {
        "cluster": {
          "description": "Cluster name.",
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_ms": {
          "description": "Remaining budget, ms.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "namespace": {
          "description": "Authenticated namespace / account / project.",
          "type": [
            "string",
            "null"
          ]
        },
        "principal": {
          "description": "Authenticated caller (admission `userInfo.username`, Slurm `submit_uid`).",
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "description": "Adapter-specific settings (the `[k8s]`, `[slurm]`, … config section).",
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      }
    },
    "AttemptContext": {
      "description": "The current attempt, as an orchestrator publishes it (SPEC §7.2).",
      "type": "object",
      "properties": {
        "attempt": {
          "description": "1-based.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "invocation_id": {
          "description": "Stable across attempts of one task instance.",
          "type": "string"
        },
        "max_attempts": {
          "description": "`None`: unknown → no ladder.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "v": {
          "description": "Wire version (1).",
          "type": "integer",
          "format": "uint16",
          "default": 1,
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "invocation_id",
        "attempt"
      ]
    },
    "Mode": {
      "description": "Mode, ordered `off < observe < recommend < enforce` (SPEC §4).",
      "oneOf": [
        {
          "description": "Do nothing.",
          "type": "string",
          "const": "off"
        },
        {
          "description": "Record outcomes only.",
          "type": "string",
          "const": "observe"
        },
        {
          "description": "Decide and record, change nothing.",
          "type": "string",
          "const": "recommend"
        },
        {
          "description": "Apply under the safety contract.",
          "type": "string",
          "const": "enforce"
        }
      ]
    },
    "Native": {
      "description": "A native submission, as the plugin received it (plugins.md §2).\nJSON: `{\"kind\": \"document\", \"media_type\": ..., \"bytes\": \"<base64>\"}`, …",
      "oneOf": [
        {
          "description": "YAML/JSON manifests, sbatch scripts, pipeline definitions.",
          "type": "object",
          "properties": {
            "bytes": {
              "description": "The bytes (base64 on the wire).",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "document"
            },
            "media_type": {
              "description": "Media type (`application/yaml`, `text/x-shellscript`).",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "media_type",
            "bytes"
          ]
        },
        {
          "description": "Admission request objects, Slurm option tables, Ray option dicts.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "description": "The object."
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "A cloud API request before signing (`\"sagemaker\"` / `\"CreateTrainingJob\"`).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "api_call"
            },
            "operation": {
              "description": "Operation.",
              "type": "string"
            },
            "params": {
              "description": "Parameters."
            },
            "service": {
              "description": "Service.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "service",
            "operation",
            "params"
          ]
        }
      ]
    }
  }
}
