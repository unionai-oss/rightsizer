{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RenderParams",
  "description": "`render` params.",
  "type": "object",
  "properties": {
    "deadline_ms": {
      "description": "Deadline.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "decisions": {
      "description": "Decisions.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/UnitSpec"
      }
    },
    "native": {
      "description": "The submission.",
      "$ref": "#/$defs/Native"
    }
  },
  "required": [
    "native",
    "decisions"
  ],
  "$defs": {
    "AcceleratorId": {
      "description": "A canonical accelerator id with per-device memory and family (SPEC §5.1.1).\nJSON: the canonical string, e.g. `\"A100-80G\"`; parsing is case-insensitive.",
      "oneOf": [
        {
          "description": "NVIDIA T4, 16 GB.",
          "type": "string",
          "const": "T4-16G"
        },
        {
          "description": "NVIDIA L4, 24 GB.",
          "type": "string",
          "const": "L4-24G"
        },
        {
          "description": "NVIDIA A10G (AWS), 24 GB.",
          "type": "string",
          "const": "A10G-24G"
        },
        {
          "description": "NVIDIA A10, 24 GB.",
          "type": "string",
          "const": "A10-24G"
        },
        {
          "description": "NVIDIA L40S, 48 GB.",
          "type": "string",
          "const": "L40S-48G"
        },
        {
          "description": "NVIDIA A100, 40 GB.",
          "type": "string",
          "const": "A100-40G"
        },
        {
          "description": "NVIDIA A100, 80 GB.",
          "type": "string",
          "const": "A100-80G"
        },
        {
          "description": "NVIDIA H100, 80 GB.",
          "type": "string",
          "const": "H100-80G"
        },
        {
          "description": "NVIDIA H200, 141 GB.",
          "type": "string",
          "const": "H200-141G"
        },
        {
          "description": "NVIDIA B200, 180 GB.",
          "type": "string",
          "const": "B200-180G"
        },
        {
          "description": "AMD MI300X, 192 GB.",
          "type": "string",
          "const": "MI300X-192G"
        },
        {
          "description": "Google TPU v5e (per chip).",
          "type": "string",
          "const": "TPU-V5E"
        },
        {
          "description": "Google TPU v5p (per chip).",
          "type": "string",
          "const": "TPU-V5P"
        },
        {
          "description": "Google TPU v6e / Trillium (per chip).",
          "type": "string",
          "const": "TPU-V6E"
        },
        {
          "description": "AWS Trainium 1 (per chip).",
          "type": "string",
          "const": "TRN1"
        },
        {
          "description": "AWS Trainium 2 (per chip).",
          "type": "string",
          "const": "TRN2"
        },
        {
          "description": "AWS Inferentia 2 (per chip).",
          "type": "string",
          "const": "INF2"
        },
        {
          "description": "A GPU of unknown type. Its type is never changed (SPEC §5.1.1).",
          "type": "string",
          "const": "unknown-gpu"
        }
      ]
    },
    "Bytes": {
      "description": "A byte count. JSON: an unsigned integer.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "GpuShape": {
      "description": "An accelerator type × count (SPEC §5.1, §5.4).",
      "type": "object",
      "properties": {
        "accel": {
          "description": "Canonical accelerator id.",
          "$ref": "#/$defs/AcceleratorId"
        },
        "count": {
          "description": "Number of devices.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "accel",
        "count"
      ]
    },
    "Limits": {
      "description": "Resource limits (SPEC §5.1). GPU and shm have no separate limit.",
      "type": "object",
      "properties": {
        "cpu": {
          "description": "CPU limit.",
          "anyOf": [
            {
              "$ref": "#/$defs/MilliCpu"
            },
            {
              "type": "null"
            }
          ]
        },
        "ephemeral_storage": {
          "description": "Ephemeral-storage limit.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "description": "Memory limit.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bytes"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MilliCpu": {
      "description": "CPU in millicores (1000 = one core). JSON: an unsigned integer.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "Native": {
      "description": "A native submission, as the plugin received it (plugins.md §2).\nJSON: `{\"kind\": \"document\", \"media_type\": ..., \"bytes\": \"<base64>\"}`, …",
      "oneOf": [
        {
          "description": "YAML/JSON manifests, sbatch scripts, pipeline definitions.",
          "type": "object",
          "properties": {
            "bytes": {
              "description": "The bytes (base64 on the wire).",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "document"
            },
            "media_type": {
              "description": "Media type (`application/yaml`, `text/x-shellscript`).",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "media_type",
            "bytes"
          ]
        },
        {
          "description": "Admission request objects, Slurm option tables, Ray option dicts.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "value": {
              "description": "The object."
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "A cloud API request before signing (`\"sagemaker\"` / `\"CreateTrainingJob\"`).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "api_call"
            },
            "operation": {
              "description": "Operation.",
              "type": "string"
            },
            "params": {
              "description": "Parameters."
            },
            "service": {
              "description": "Service.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "service",
            "operation",
            "params"
          ]
        }
      ]
    },
    "Requests": {
      "description": "Resource requests of one unit (SPEC §5.1). `None` = not set.",
      "type": "object",
      "properties": {
        "cpu": {
          "description": "CPU.",
          "anyOf": [
            {
              "$ref": "#/$defs/MilliCpu"
            },
            {
              "type": "null"
            }
          ]
        },
        "ephemeral_storage": {
          "description": "Ephemeral storage.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu": {
          "description": "Accelerators.",
          "anyOf": [
            {
              "$ref": "#/$defs/GpuShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "description": "Memory.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "shm": {
          "description": "Shared memory.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bytes"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ResourceSpec": {
      "description": "Requests and limits of one unit.",
      "type": "object",
      "properties": {
        "limits": {
          "description": "Limits.",
          "$ref": "#/$defs/Limits",
          "default": {}
        },
        "requests": {
          "description": "Requests.",
          "$ref": "#/$defs/Requests",
          "default": {}
        }
      }
    },
    "UnitId": {
      "description": "A unit's id, stable within its submission (plugins.md §2).",
      "type": "string"
    },
    "UnitSpec": {
      "description": "One unit's decision for `render`.",
      "type": "object",
      "properties": {
        "spec": {
          "description": "Spec to render.",
          "$ref": "#/$defs/ResourceSpec"
        },
        "unit": {
          "description": "Unit.",
          "$ref": "#/$defs/UnitId"
        }
      },
      "required": [
        "unit",
        "spec"
      ]
    }
  }
}
