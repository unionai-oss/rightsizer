{
  "title": "rightsizer",
  "uid": "rightsizer",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "rightsizer"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Decisions / s by mode and source",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode, source) (rate(rightsizer_decisions_total[5m]))",
          "legendFormat": "{{mode}} {{source}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Webhook latency",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rightsizer_webhook_admission_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rightsizer_webhook_admission_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rightsizer_decision_latency_seconds_bucket[5m])))",
          "legendFormat": "decision p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Webhook requests by result",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (webhook, result) (rate(rightsizer_webhook_requests_total[5m]))",
          "legendFormat": "{{webhook}} {{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fail-open (apiserver and webhook)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (increase(apiserver_admission_webhook_fail_open_count{name=~\"jobs.rightsizer.io|pods.rightsizer.io\"}[15m]))",
          "legendFormat": "apiserver {{name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (increase(rightsizer_webhook_fail_open_total[15m]))",
          "legendFormat": "webhook {{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outcome join ratio",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rightsizer_outcome_join_ratio",
          "legendFormat": "{{platform}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rightsizer-caused failures",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (platform) (increase(rightsizer_caused_failures_total[1h]))",
          "legendFormat": "{{platform}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Breakers open",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rightsizer_breaker_open",
          "legendFormat": "{{scope}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Held / clamped",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (axis, reason) (rate(rightsizer_held_total[15m]))",
          "legendFormat": "held {{axis}} {{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(rightsizer_clamped_total[15m]))",
          "legendFormat": "clamped {{reason}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Saved resource-hours",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (axis) (increase(rightsizer_saved_resource_hours_total[1d]))",
          "legendFormat": "{{axis}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Watcher lag and records",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rightsizer_watcher_lag_seconds",
          "legendFormat": "lag (s)"
        },
        {
          "refId": "B",
          "expr": "sum by (status, peak_source) (rate(rightsizer_watcher_records_total[15m]))",
          "legendFormat": "{{status}} {{peak_source}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Store: compaction lag, errors",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rightsizer_store_compaction_lag_seconds",
          "legendFormat": "compaction lag (s)"
        },
        {
          "refId": "B",
          "expr": "sum by (op) (rate(rightsizer_store_errors_total[5m]))",
          "legendFormat": "errors {{op}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Estimator circuits open",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rightsizer_estimator_circuit_open",
          "legendFormat": "{{estimator}}"
        }
      ]
    }
  ]
}